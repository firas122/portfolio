---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { experience } = getContent(lang);
---

{/* A rail rather than a stack of boxes: roles hang off one line, so the
    sequence is visible before any of it is read. */}
<section id="experience" class="band shell">
  <p class="key">{experience.heading}</p>
  <h2 class="display mt-4 text-section max-w-xl">{experience.subheading}</h2>

  <ol class="mt-12 border-l border-edge">
    {
      experience.items.map((item) => (
        <li class="group relative pb-10 pl-7 last:pb-0 sm:pl-10">
          <span
            class:list={[
              "absolute -left-[4.5px] top-1.5 h-2 w-2 rounded-pill ring-4 ring-bg transition-colors",
              item.current ? "bg-gold" : "bg-edge-strong group-hover:bg-gold",
            ]}
          />
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="display text-[1.2rem] leading-snug">{item.role}</h3>
            <span class="text-[14px] text-gold">{item.company}</span>
          </div>
          <p class="mt-1 font-mono text-[11.5px] text-fg-faint">{item.period}</p>
          <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-fg-muted">{item.description}</p>
        </li>
      ))
    }
  </ol>
</section>
