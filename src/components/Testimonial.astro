---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { testimonial, person } = getContent(lang);
---

<section id="testimonial" class="section-shell py-14 sm:py-20">
  <p class="section-heading">{testimonial.eyebrow}</p>
  <h2 class="mt-3 max-w-xl text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-ink-100">
    {testimonial.heading}
  </h2>

  <figure class="panel glow-border relative mt-12 max-w-3xl rounded-2xl p-8 sm:p-10">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-9 w-9 text-accent/25"
      aria-hidden="true"
    >
      <path d="M9.5 6.5C6.46 6.5 4 8.96 4 12c0 2.76 2 5 4.5 5 .28 0 .5.22.5.5s-.22.5-.5.5C5.46 18 3 15.31 3 12c0-3.86 3.14-7 7-7 .28 0 .5.22.5.5s-.22.5-.5.5Zm11 0c-3.04 0-5.5 2.46-5.5 5.5 0 2.76 2 5 4.5 5 .28 0 .5.22.5.5s-.22.5-.5.5c-3.04 0-5.5-2.69-5.5-6 0-3.86 3.14-7 7-7 .28 0 .5.22.5.5s-.22.5-.5.5Z" />
    </svg>

    <blockquote class="mt-4 text-xl font-medium leading-relaxed text-ink-900 dark:text-ink-100">
      {testimonial.quote}
    </blockquote>

    <figcaption class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-ink-200/70 pt-5 dark:border-ink-700/60">
      <div>
        <div class="flex items-center gap-1 text-accent" aria-label={testimonial.ratedOutOf5(testimonial.rating)}>
          {
            Array.from({ length: 5 }).map((_, i) => (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill={i < testimonial.rating ? "currentColor" : "none"}
                stroke="currentColor"
                stroke-width={i < testimonial.rating ? "0" : "1.5"}
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1 1 5.79L10 14.77l-5.21 2.74 1-5.79-4.21-4.1 5.82-.85L10 1.5Z" />
              </svg>
            ))
          }
        </div>
        <p class="mt-2 text-sm font-semibold text-ink-900 dark:text-ink-100">
          <a
            href={person.links.upwork}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-ink-200 underline-offset-4 hover:text-accent-dim dark:decoration-ink-700 dark:hover:text-accent"
          >
            {testimonial.source}
          </a>
          <span class="font-normal text-ink-400"> · {testimonial.verifiedOn}</span>
        </p>
        <p class="mt-0.5 text-xs text-ink-400">{testimonial.context}</p>
      </div>
    </figcaption>
  </figure>
</section>
