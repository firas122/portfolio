---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { testimonial } = getContent(lang);
---

{/* A pull-quote band, not a card: the display face does the work and the
    attribution sits quietly under a rule. */}
<section class="border-y border-edge bg-panel/40 py-20 sm:py-24">
  <div class="shell max-w-4xl">
    <p class="key">{testimonial.eyebrow}</p>

    <blockquote class="mt-7">
      <p class="display text-[clamp(1.5rem,3.2vw,2.3rem)] leading-[1.25]">
        <span class="text-gold">“</span>{testimonial.quote}<span class="text-gold">”</span>
      </p>
    </blockquote>

    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-edge pt-6">
      <div
        class="flex items-center gap-0.5 text-gold"
        role="img"
        aria-label={testimonial.ratedOutOf5(testimonial.rating)}
      >
        {
          Array.from({ length: testimonial.rating }).map(() => (
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="m12 17.3-6.2 3.7 1.7-7L2 9.2l7.1-.6L12 2l2.9 6.6 7.1.6-5.5 4.8 1.7 7z" />
            </svg>
          ))
        }
      </div>
      <p class="text-[14px] font-medium text-fg">{testimonial.source}</p>
      <p class="font-mono text-[11.5px] text-fg-faint">{testimonial.verifiedOn}</p>
      <p class="w-full text-[13px] text-fg-faint sm:w-auto sm:border-l sm:border-edge sm:pl-5">
        {testimonial.context}
      </p>
    </div>
  </div>
</section>
