---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { proof } = getContent(lang);
---

{/* A band of measured figures directly under the hero. Nothing here is an
    adjective — every number is one a project actually produced. */}
<section class="border-y border-edge bg-panel/50">
  <div class="shell grid grid-cols-2 gap-px bg-edge sm:grid-cols-4">
    {
      proof.items.map((item) => (
        <div class="bg-bg px-5 py-7 sm:px-6">
          <p class="figure text-[1.75rem] leading-none text-gold sm:text-[2rem]">{item.value}</p>
          <p class="mt-2 text-[12.5px] leading-snug text-fg-faint">{item.label}</p>
        </div>
      ))
    }
  </div>
</section>
