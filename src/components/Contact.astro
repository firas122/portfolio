---
import { contact, person } from "@/data/content";

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID || contact.formspreeId;
const formAction = `https://formspree.io/f/${formspreeId}`;
---

<section id="contact" class="border-t border-ink-100/80 py-20 sm:py-28 dark:border-ink-700/60">
  <div class="section-shell grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="section-heading">Contact</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-ink-100">
        {contact.heading}
      </h2>
      <p class="mt-4 max-w-md text-base leading-relaxed text-ink-400">{contact.body}</p>

      <div class="mt-8 flex flex-col gap-3">
        <a
          href={`mailto:${person.email}`}
          class="inline-flex w-fit items-center gap-2 rounded-full border border-ink-100 px-5 py-3 text-sm font-semibold text-ink-900 transition-colors hover:border-accent/50 hover:text-accent-dim dark:border-ink-700 dark:text-ink-100 dark:hover:text-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
            <path d="M4 4h16v16H4zM22 6l-10 7L2 6" />
          </svg>
          {person.email}
        </a>
        <a
          href={person.links.upwork}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-center gap-2 rounded-full bg-ink-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-dim dark:bg-accent dark:text-ink-950 dark:hover:bg-accent-bright"
        >
          Hire me on Upwork
        </a>
      </div>
    </div>

    <form
      action={formAction}
      method="POST"
      class="panel flex flex-col gap-4 rounded-2xl p-6"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-1.5">
          <label for="name" class="font-mono text-xs uppercase tracking-widest text-ink-400">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="rounded-lg border border-ink-100 bg-white px-3 py-2.5 text-sm text-ink-900 outline-none transition-colors focus:border-accent dark:border-ink-700 dark:bg-ink-800 dark:text-ink-100"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="email" class="font-mono text-xs uppercase tracking-widest text-ink-400">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="rounded-lg border border-ink-100 bg-white px-3 py-2.5 text-sm text-ink-900 outline-none transition-colors focus:border-accent dark:border-ink-700 dark:bg-ink-800 dark:text-ink-100"
          />
        </div>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="message" class="font-mono text-xs uppercase tracking-widest text-ink-400">
          What do you need extracted?
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          placeholder="Describe your documents, or drop a link to a sample."
          class="resize-none rounded-lg border border-ink-100 bg-white px-3 py-2.5 text-sm text-ink-900 outline-none transition-colors focus:border-accent dark:border-ink-700 dark:bg-ink-800 dark:text-ink-100"
        ></textarea>
      </div>

      <button
        type="submit"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-ink-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-dim dark:bg-accent dark:text-ink-950 dark:hover:bg-accent-bright"
      >
        Send message
      </button>

      <p class="text-center text-xs text-ink-400">
        Or just email me directly at <a href={`mailto:${person.email}`} class="underline hover:text-accent-dim dark:hover:text-accent">{person.email}</a>.
      </p>
    </form>
  </div>
</section>
