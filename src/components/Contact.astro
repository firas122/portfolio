---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { contact, person } = getContent(lang);

const mailto = `mailto:${person.email}?subject=${encodeURIComponent(contact.direct.mailSubject)}`;
const elsewhere = [
  { label: "Upwork", href: person.links.upwork },
  { label: "LinkedIn", href: person.links.linkedin },
  { label: "GitHub", href: person.links.github },
];
---

{/* The page's one loud moment: a full-width lit panel, so the close reads as a
    destination rather than another section. */}
<section id="contact" class="band shell">
  <div class="card relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-px bg-gold-sweep"></div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(38rem_22rem_at_18%_0%,rgb(var(--gold)/0.12),transparent_65%)]"
    >
    </div>

    <div class="relative grid gap-10 p-7 sm:p-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16 lg:p-14">
      <div>
        <p class="key">{contact.eyebrow}</p>
        <h2 class="display mt-4 text-section max-w-xl">{contact.heading}</h2>
        <p class="lead mt-6">{contact.body}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={mailto} class="btn-gold">
            {person.email}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href={person.links.upwork} target="_blank" rel="noopener noreferrer" class="btn-line">
            {contact.hireMeUpwork}
          </a>
        </div>
      </div>

      <div class="lg:border-l lg:border-edge lg:pl-12">
        <h3 class="display text-[1.15rem]">{contact.direct.heading}</h3>
        <p class="mt-3 text-[14.5px] leading-relaxed text-fg-muted">{contact.direct.body}</p>

        <p class="key mt-8">{contact.direct.elsewhere}</p>
        <ul class="mt-4 grid gap-2.5">
          {
            elsewhere.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer" class="ul-draw text-[14.5px]">
                  {item.label}
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
