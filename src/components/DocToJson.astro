---
// Pure CSS/SVG visual: a messy scanned document resolving into clean,
// structured JSON. No raster images used.
const jsonLines = [
  { key: "document_type", value: '"invoice"', delay: 0 },
  { key: "vendor", value: '"Acme Supplies Co."', delay: 60 },
  { key: "invoice_number", value: '"INV-0342"', delay: 120 },
  { key: "total", value: "1240.00", delay: 180, isNumber: true },
  { key: "currency", value: '"USD"', delay: 240 },
  { key: "confidence", value: "0.98", delay: 300, isNumber: true },
];
---

<div class="relative">
  <div class="absolute -inset-6 rounded-[2.5rem] bg-accent/10 blur-3xl dark:bg-accent/20" aria-hidden="true"></div>

  <div class="relative grid gap-3">
    <!-- Messy scanned document -->
    <div class="panel glow-border relative overflow-hidden rounded-2xl p-5 shadow-xl shadow-ink-900/[0.08] animate-float" aria-hidden="true">
      <div class="mb-4 flex items-center justify-between">
        <div class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber-400/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/70"></span>
        </div>
        <span class="font-mono text-[10px] uppercase tracking-widest text-ink-400">scan_0342.pdf</span>
      </div>

      <div class="space-y-3 blur-[1px]" style="transform: rotate(-0.3deg)">
        <!-- Invoice title + number/date fields -->
        <div class="flex items-start justify-between">
          <div class="h-3 w-20 rounded bg-ink-600 dark:bg-ink-100"></div>
          <div class="flex flex-col items-end gap-1.5">
            <div class="h-2 w-24 rounded bg-ink-400/70 dark:bg-ink-200/90"></div>
            <div class="h-2 w-16 rounded bg-ink-400/50 dark:bg-ink-200/60"></div>
          </div>
        </div>

        <!-- Bill-to fields -->
        <div class="space-y-1.5 pt-1">
          <div class="h-2 w-1/3 rounded bg-ink-400/60 dark:bg-ink-200/70"></div>
          <div class="h-2 w-1/2 rounded bg-ink-400/45 dark:bg-ink-200/50"></div>
        </div>

        <!-- Line-item table -->
        <div class="mt-1 overflow-hidden rounded border border-ink-400/40 dark:border-ink-400/40">
          <div class="grid grid-cols-[3fr_1fr_1fr] gap-2 bg-ink-200 px-2 py-1.5 dark:bg-ink-700">
            <div class="h-2 w-3/4 rounded bg-ink-600 dark:bg-ink-100"></div>
            <div class="h-2 w-1/2 rounded bg-ink-600 dark:bg-ink-100"></div>
            <div class="h-2 w-2/3 rounded bg-ink-600 dark:bg-ink-100"></div>
          </div>
          <div class="grid grid-cols-[3fr_1fr_1fr] gap-2 border-t border-ink-400/30 px-2 py-1.5 dark:border-ink-400/30">
            <div class="h-2 w-full rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
            <div class="h-2 w-1/2 rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
            <div class="h-2 w-2/3 rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
          </div>
          <div class="grid grid-cols-[3fr_1fr_1fr] gap-2 border-t border-ink-400/30 px-2 py-1.5 dark:border-ink-400/30">
            <div class="h-2 w-5/6 rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
            <div class="h-2 w-1/3 rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
            <div class="h-2 w-2/3 rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
          </div>
          <div class="grid grid-cols-[3fr_1fr_1fr] gap-2 border-t border-ink-400/30 px-2 py-1.5 dark:border-ink-400/30">
            <div class="h-2 w-2/3 rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
            <div class="h-2 w-1/2 rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
            <div class="h-2 w-2/3 rounded bg-ink-400/60 dark:bg-ink-200/75"></div>
          </div>
        </div>

        <!-- Totals -->
        <div class="flex justify-end pt-1">
          <div class="w-2/5 space-y-1.5">
            <div class="flex items-center justify-between">
              <div class="h-2 w-12 rounded bg-ink-400/50 dark:bg-ink-200/60"></div>
              <div class="h-2 w-10 rounded bg-ink-400/50 dark:bg-ink-200/60"></div>
            </div>
            <div class="flex items-center justify-between">
              <div class="h-2 w-8 rounded bg-ink-400/50 dark:bg-ink-200/60"></div>
              <div class="h-2 w-10 rounded bg-ink-400/50 dark:bg-ink-200/60"></div>
            </div>
            <div class="flex items-center justify-between border-t border-ink-400/40 pt-1.5 dark:border-ink-400/40">
              <div class="h-2.5 w-10 rounded bg-accent/70 dark:bg-accent"></div>
              <div class="h-2.5 w-14 rounded bg-accent dark:bg-accent-bright"></div>
            </div>
          </div>
        </div>
      </div>

      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-accent/40 via-accent/10 to-transparent animate-scan"
      >
      </div>
    </div>

    <!-- Connector -->
    <div class="flex items-center justify-center gap-2 py-1 text-ink-400" aria-hidden="true">
      <span class="h-px w-10 bg-gradient-to-r from-transparent to-ink-200 dark:to-ink-700"></span>
      <span class="font-mono text-[10px] uppercase tracking-widest text-accent-dim dark:text-accent">extracting</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 text-accent-dim dark:text-accent">
        <path d="M12 5v14M6 13l6 6 6-6"></path>
      </svg>
      <span class="h-px w-10 bg-gradient-to-l from-transparent to-ink-200 dark:to-ink-700"></span>
    </div>

    <!-- Structured JSON output -->
    <div class="panel glow-border rounded-2xl p-5 shadow-xl shadow-accent/10" aria-hidden="true">
      <div class="mb-4 flex items-center justify-between">
        <div class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber-400/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/70"></span>
        </div>
        <span class="font-mono text-[10px] uppercase tracking-widest text-accent-dim dark:text-accent">structured.json</span>
      </div>

      <pre class="overflow-x-auto font-mono text-[13px] leading-relaxed"><code>{"{"}
{jsonLines.map((line, i) => (
  <span
    class="block animate-fade-up opacity-0"
    style={`animation-delay: ${500 + line.delay}ms; animation-fill-mode: forwards;`}
  >  <span class="text-accent-dim dark:text-accent">"{line.key}"</span><span class="text-ink-400">:</span> <span class={line.isNumber ? "text-ink-900 dark:text-ink-100" : "text-emerald-600 dark:text-emerald-400"}>{line.value}</span>{i < jsonLines.length - 1 ? "," : ""}</span>
))}
{"}"}</code></pre>
    </div>
  </div>
</div>
