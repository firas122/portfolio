---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { services, skills } = getContent(lang);

// Services and skills used to be two sections saying the same thing twice —
// what I do, then the tools I do it with. They read better as one: the
// capability, and the stack behind it on the same surface.
const icons = [
  "M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1ZM14 3v5h5M9 13h6M9 17h6",
  "M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3M8 12h8",
  "M4 6h10M18 6h2M4 12h4M12 12h8M4 18h13M8 4v4M16 10v4",
  "M4 4h16v16H4zM8 9l3 3-3 3M13 15h4",
];
---

<section id="services" class="band shell">
  <div class="band-head">
    <p class="eyebrow">{services.heading}</p>
    <h2 class="h-section">{services.subheading}</h2>
  </div>

  <div class="mt-12 grid gap-px overflow-hidden rounded-card border border-edge bg-edge sm:grid-cols-2">
    {
      services.items.map((service, i) => (
        <div class="group bg-panel p-6 transition-colors duration-300 hover:bg-panel-raised sm:p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-card border border-brand/30 bg-brand/10 text-brand transition-colors duration-300 group-hover:bg-brand/20">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d={icons[i % icons.length]} stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="font-display font-semibold mt-5 text-[1.15rem] leading-snug">{service.title}</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-fg-muted">{service.description}</p>
        </div>
      ))
    }
  </div>

  <div id="skills" class="mt-10 scroll-mt-28">
    <p class="eyebrow">{skills.heading}</p>
    <div class="mt-6 grid gap-x-12 gap-y-8 sm:grid-cols-2">
      {
        skills.groups.map((group) => (
          <div>
            <h3 class="font-mono text-[12px] text-fg">{group.category}</h3>
            <div class="mt-3 h-px w-full bg-edge"></div>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
