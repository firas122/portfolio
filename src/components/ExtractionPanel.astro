---
// The hero's visual argument, in the subject's own terms: a scanned document
// on the left, the fields it resolves to on the right, and a pass of light
// moving down it. Pure CSS — no scroll listener, no canvas, no library — so it
// costs nothing and cannot jank.
const fields: { key: string; value: string }[] = [
  { key: "type", value: '"invoice"' },
  { key: "vendor", value: '"Acme Co."' },
  { key: "number", value: '"INV-0342"' },
  { key: "total", value: "1240.00" },
  { key: "currency", value: '"USD"' },
  { key: "due", value: '"2026-11-14"' },
];

// Line lengths for the fake page, kept here so the markup stays readable.
const paperRows = [92, 64, 78, 46, 84, 58, 71, 40, 88, 52];
---

<figure class="relative">
  <div class="card overflow-hidden">
    <div class="flex items-center gap-2 border-b border-edge px-4 py-2.5">
      <span class="h-2 w-2 rounded-pill bg-gold"></span>
      <span class="font-mono text-[11px] text-fg-faint">scan_0342.pdf</span>
      <span class="chip-gold ml-auto">extracting</span>
    </div>

    <div class="grid gap-px bg-edge sm:grid-cols-2">
      {/* The page */}
      <div class="relative overflow-hidden bg-panel-raised p-4">
        <div class="space-y-2.5">
          {
            paperRows.map((w) => (
              <div class="h-1.5 rounded-pill bg-fg/10" style={`width:${w}%`}></div>
            ))
          }
        </div>
        {/* The pass of light. Masked to the panel, so it reads as a scan. */}
        <div
          class="pointer-events-none absolute inset-x-0 top-0 h-10 animate-sweep bg-[linear-gradient(to_bottom,transparent,rgb(var(--gold)/0.22),transparent)]"
        >
        </div>
      </div>

      {/* What it resolved to */}
      <div class="bg-panel p-4 font-mono text-[11.5px] leading-relaxed">
        <p class="text-fg-faint">{"{"}</p>
        {
          fields.map((field) => (
            <p class="truncate pl-3">
              <span class="text-fg-muted">"{field.key}"</span>
              <span class="text-fg-faint">: </span>
              <span class="text-gold">{field.value}</span>
              <span class="text-fg-faint">,</span>
            </p>
          ))
        }
        <p class="text-fg-faint">{"}"}</p>
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-edge px-4 py-2.5">
      <span class="font-mono text-[11px] text-fg-faint">6 fields</span>
      <span class="font-mono text-[11px] text-fg-muted">
        confidence <span class="text-gold">0.99</span>
      </span>
    </div>
  </div>
</figure>
