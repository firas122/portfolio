---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { skills } = getContent(lang);
---

<section id="skills" class="section-shell scroll-mt-24 py-16 sm:py-20">
  <p class="field-label">{skills.heading}</p>
  <h2 class="section-title max-w-xl">
    {skills.subheading}
  </h2>

  <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.groups.map((group) => (
        <div class="record p-6">
          <h3 class="font-mono text-xs uppercase tracking-widest text-accent-dim dark:text-accent-bright">{group.category}</h3>
          <ul class="mt-4 space-y-2.5">
            {group.items.map((item) => (
              <li class="flex items-center gap-2 text-sm text-ink-900 dark:text-ink-100">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
