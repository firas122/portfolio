---
import { skills } from "@/data/content";
---

<section id="skills" class="section-shell py-20 sm:py-28">
  <p class="section-heading">Skills</p>
  <h2 class="mt-3 max-w-xl text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-ink-100">
    Tools I actually use.
  </h2>

  <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((group) => (
        <div class="panel rounded-2xl p-6">
          <h3 class="font-mono text-xs uppercase tracking-widest text-accent-dim dark:text-accent">{group.category}</h3>
          <ul class="mt-4 space-y-2.5">
            {group.items.map((item) => (
              <li class="flex items-center gap-2 text-sm text-ink-900 dark:text-ink-100">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
