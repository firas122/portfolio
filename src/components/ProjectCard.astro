---
import type { Project } from "@/i18n/en";

// Feature rows carry figures; compact cards fill the grid below. Both are a
// single flowing column, so a card is only as tall as its content — no side
// panel stretched to match a longer neighbour.
interface Props {
  project: Project;
  labels: { problem: string; approach: string; outcome: string };
  feature?: boolean;
  index: number;
}

const { project, labels, feature = false, index } = Astro.props;
const links = project.links ?? (project.link ? [{ ...project.link, kind: "case" as const }] : []);
const ordinal = String(index + 1).padStart(2, "0");
const sections = [
  { label: labels.problem, text: project.problem },
  { label: labels.approach, text: project.approach },
  { label: labels.outcome, text: project.outcome },
];
// Column widths follow text length so the two columns end at about the same
// height whatever the copy is; clamped so neither gets uncomfortably narrow.
const shortLen = sections[0].text.length + sections[2].text.length + 120; // +120: the extra label and gap
const longLen = sections[1].text.length;
const ratio = Math.min(1.6, Math.max(0.7, shortLen / longLen));
const columns = `${ratio.toFixed(2)}fr 1fr`;
---

<article class:list={["card group relative overflow-hidden", feature ? "" : "card-hover flex flex-col"]}>
  {feature && <div class="absolute inset-x-0 top-0 h-px bg-brand-fill"></div>}

  <div class:list={["flex flex-1 flex-col", feature ? "p-6 sm:p-9" : "p-6"]}>
    <div class="flex items-center gap-3">
      <span class="font-mono text-[11px] text-fg-faint">{ordinal}</span>
      <span class="pill-brand">{project.tag}</span>
    </div>

    <h3
      class:list={[
        "font-display font-semibold mt-4 tracking-tight",
        feature ? "text-[1.9rem] leading-[1.1] sm:text-[2.3rem]" : "text-[1.3rem] leading-snug",
      ]}
    >
      {project.title}
    </h3>

    {
      feature && project.metrics && (
        <dl class="mt-7 grid gap-px overflow-hidden rounded-2xl border border-edge bg-edge sm:grid-cols-3">
          {project.metrics.map((metric) => (
            <div class="bg-panel-raised px-5 py-4">
              <dd class="stat text-[2rem] leading-none text-brand">{metric.value}</dd>
              <dt class="mt-2 text-[12px] leading-snug text-fg-faint">{metric.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    {/* Problem and outcome are short, approach is long: stacking the two short
        ones against the long one keeps the columns near the same height. */}
    <div
      class:list={[
        "mt-7 text-fg-muted",
        feature ? "grid gap-x-10 gap-y-6 text-[15px] lg:[grid-template-columns:var(--cols)]" : "space-y-4 text-[14px]",
      ]}
      style={feature ? `--cols: ${columns}` : undefined}
    >
      {
        feature ? (
          <>
            <div class="space-y-6">
              {[sections[0], sections[2]].map((s) => (
                <p class="leading-relaxed">
                  <span class="eyebrow mb-1 block">{s.label}</span>
                  {s.text}
                </p>
              ))}
            </div>
            <p class="leading-relaxed">
              <span class="eyebrow mb-1 block">{sections[1].label}</span>
              {sections[1].text}
            </p>
          </>
        ) : (
          sections.map((s) => (
            <p class="leading-relaxed">
              <span class="eyebrow mb-1 block">{s.label}</span>
              {s.text}
            </p>
          ))
        )
      }
    </div>

    <div
      class:list={[
        "mt-auto flex flex-col gap-5 pt-7",
        feature ? "lg:flex-row lg:items-center lg:justify-between" : "",
      ]}
    >
      <div class="flex flex-wrap gap-1.5">
        {project.stack.map((tech) => <span class="tag">{tech}</span>)}
      </div>

      {
        links.length > 0 ? (
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            {links.map((link) =>
              link.kind === "demo" ? (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="btn-brand h-9 px-4 text-[13px]">
                  {link.label}
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </a>
              ) : (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="link-arrow text-[13.5px]">
                  {link.label}
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </a>
              ),
            )}
          </div>
        ) : (
          project.linkNote && (
            <p class:list={["text-[12.5px] leading-snug text-fg-faint", feature ? "lg:max-w-xs lg:text-right" : ""]}>
              {project.linkNote}
            </p>
          )
        )
      }
    </div>
  </div>
</article>
