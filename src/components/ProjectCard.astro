---
import type { Project } from "@/i18n/en";

// One project, in one of two densities. `feature` gets the alternating
// full-width treatment; the compact form fills the grid below it.
interface Props {
  project: Project;
  labels: { problem: string; approach: string; outcome: string };
  feature?: boolean;
  /** Feature rows alternate which side the figures sit on. */
  flip?: boolean;
  index: number;
}

const { project, labels, feature = false, flip = false, index } = Astro.props;
const links = project.links ?? (project.link ? [{ ...project.link, kind: "case" as const }] : []);
const ordinal = String(index + 1).padStart(2, "0");
---

<article
  class:list={[
    "card group relative overflow-hidden",
    feature ? "" : "card-hover flex flex-col",
  ]}
>
  {/* A warm edge lights the top of a feature row — the only gradient on a
      surface, so it stays an accent rather than a texture. */}
  {feature && <div class="absolute inset-x-0 top-0 h-px bg-brand-fill"></div>}

  <div
    class:list={[
      feature ? "grid gap-px bg-edge lg:grid-cols-[1.25fr_1fr]" : "flex flex-1 flex-col",
    ]}
  >
    <div class:list={["bg-panel", feature ? "p-6 sm:p-9" : "p-6", flip && feature ? "lg:order-2" : ""]}>
      <div class="flex items-center gap-3">
        <span class="font-mono text-[11px] text-fg-faint">{ordinal}</span>
        <span class="pill-brand">{project.tag}</span>
      </div>

      <h3
        class:list={[
          "font-display font-semibold mt-4 tracking-tight",
          feature ? "text-[1.9rem] leading-[1.1] sm:text-[2.3rem]" : "text-[1.3rem] leading-snug",
        ]}
      >
        {project.title}
      </h3>

      <div class:list={["mt-5 space-y-4", feature ? "text-[15px]" : "text-[14px]"]}>
        <p class="leading-relaxed text-fg-muted">
          <span class="eyebrow mb-1 block">{labels.problem}</span>
          {project.problem}
        </p>
        <p class="leading-relaxed text-fg-muted">
          <span class="eyebrow mb-1 block">{labels.approach}</span>
          {project.approach}
        </p>
        <p class="leading-relaxed text-fg-muted">
          <span class="eyebrow mb-1 block">{labels.outcome}</span>
          {project.outcome}
        </p>
      </div>

      <div class="mt-6 flex flex-wrap gap-1.5">
        {project.stack.map((tech) => <span class="tag">{tech}</span>)}
      </div>
    </div>

    {/* Figures and links: their own panel on a feature row, a footer below. */}
    <div
      class:list={[
        "flex flex-col bg-panel-raised",
        feature ? "justify-between p-6 sm:p-9" : "mt-auto gap-4 p-6",
        flip && feature ? "lg:order-1" : "",
      ]}
    >
      {
        project.metrics && (
          <dl class:list={[feature ? "space-y-6" : "flex flex-col gap-3 sm:grid sm:grid-cols-3"]}>
            {project.metrics.map((metric) => (
              <div>
                <dd class:list={["stat leading-none text-brand", feature ? "text-[2rem]" : "text-[1.1rem]"]}>
                  {metric.value}
                </dd>
                <dt class="mt-1.5 text-[12px] leading-snug text-fg-faint">{metric.label}</dt>
              </div>
            ))}
          </dl>
        )
      }

      {
        (links.length > 0 || project.linkNote) && (
          <div class:list={[feature && project.metrics ? "mt-8" : ""]}>
            {links.length > 0 ? (
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                {links.map((link) =>
                  link.kind === "demo" ? (
                    <a href={link.href} target="_blank" rel="noopener noreferrer" class="btn-brand h-9 px-4 text-[13px]">
                      {link.label}
                      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17 17 7M7 7h10v10" />
                      </svg>
                    </a>
                  ) : (
                    <a href={link.href} target="_blank" rel="noopener noreferrer" class="link-arrow text-[13.5px]">
                      {link.label}
                      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17 17 7M7 7h10v10" />
                      </svg>
                    </a>
                  ),
                )}
              </div>
            ) : (
              <p class="text-[12.5px] leading-snug text-fg-faint">{project.linkNote}</p>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>
