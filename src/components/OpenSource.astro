---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { openSource } = getContent(lang);
---

{/* Kept visually distinct from Work: a quieter band, because the authorship is
    different and the design should say so before the text does. */}
<section id="open-source" class="band border-y border-edge bg-panel/40">
  <div class="shell">
    <div class="band-head">
    <p class="eyebrow">{openSource.heading}</p>
    <h2 class="h-section">{openSource.subheading}</h2>
  </div>

    <div class="mt-10 grid gap-6">
      {
        openSource.items.map((item) => (
          <article class="card card-hover p-6 sm:p-8">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
              <h3 class="font-display font-semibold text-[1.5rem] leading-tight">{item.title}</h3>
              <span class="font-mono text-[12px] text-fg-faint">{item.upstream}</span>
              <span class="pill-brand ml-auto">{item.tag}</span>
            </div>

            <div class="mt-6 grid gap-x-10 gap-y-5 md:grid-cols-2">
              <p class="text-[14.5px] leading-relaxed text-fg-faint">{item.summary}</p>
              <p class="text-[14.5px] leading-relaxed text-fg-muted">
                <span class="eyebrow mb-1 block">{openSource.roleLabel}</span>
                {item.contribution}
              </p>
            </div>

            <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-edge pt-5">
              <div class="flex flex-wrap gap-1.5">
                {item.stack.map((tech) => <span class="tag">{tech}</span>)}
              </div>
              {item.links?.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="link-arrow text-[13.5px]">
                  {link.label}
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
