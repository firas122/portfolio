---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { footer, person, nav } = getContent(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-edge">
  <div class="shell flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-[12px] text-fg-faint">{footer.builtWith(year, person.name)}</p>

    <nav class="flex flex-wrap gap-x-5 gap-y-2">
      {
        nav.map((item) => (
          <a href={item.href} class="text-[13px] text-fg-faint transition-colors hover:text-gold">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
