---
import { getContent } from "@/i18n";
import Portrait from "@/components/Portrait.astro";

const lang = Astro.currentLocale ?? "en";
const { about, person } = getContent(lang);
---

{/* Narrative in the wide column, facts on a rail beside it — rather than the
    portrait-and-paragraphs block this used to be. */}
<section id="about" class="band shell">
  <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
    <div>
      <p class="eyebrow">{about.heading}</p>
      <h2 class="h-section max-w-xl">{about.subheading}</h2>
      <div class="mt-8 space-y-5">
        {
          about.paragraphs.map((paragraph, i) => (
            <p class:list={["leading-relaxed", i === 0 ? "text-lead text-fg" : "text-[15.5px] text-fg-muted"]}>
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>

    <aside class="lg:pt-16">
      <div class="card overflow-hidden">
        <Portrait class="aspect-[4/5] w-full" placeholderClass="text-6xl" loading="lazy" />
        <dl class="divide-y divide-edge border-t border-edge">
          <div class="flex items-baseline justify-between gap-4 px-5 py-4">
            <dt class="eyebrow">{about.basedInLabel}</dt>
            <dd class="text-right text-[14px] text-fg">{person.location}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 px-5 py-4">
            <dt class="eyebrow">{about.languagesLabel}</dt>
            <dd class="text-right text-[14px] text-fg">{person.languages.join(" · ")}</dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</section>
