---
import { about, person } from "@/data/content";
---

<section id="about" class="section-shell py-20 sm:py-28">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
    <div>
      <p class="section-heading">{about.heading}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-ink-100">
        Document AI, from OCR to API.
      </h2>
    </div>

    <div class="space-y-5">
      {
        about.paragraphs.map((paragraph) => (
          <p class="text-base leading-relaxed text-ink-400 sm:text-lg">{paragraph}</p>
        ))
      }

      <dl class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="panel rounded-xl p-4">
          <dt class="font-mono text-xs uppercase tracking-widest text-accent-dim dark:text-accent">Based in</dt>
          <dd class="mt-1 text-sm text-ink-900 dark:text-ink-100">{person.location}</dd>
        </div>
        <div class="panel rounded-xl p-4">
          <dt class="font-mono text-xs uppercase tracking-widest text-accent-dim dark:text-accent">Languages</dt>
          <dd class="mt-1 text-sm text-ink-900 dark:text-ink-100">{person.languages.join(" · ")}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
