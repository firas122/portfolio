---
import { getContent } from "@/i18n";
import ProjectCard from "@/components/ProjectCard.astro";

const lang = Astro.currentLocale ?? "en";
const { projects } = getContent(lang);

const labels = {
  problem: projects.problemLabel,
  approach: projects.approachLabel,
  outcome: projects.outcomeLabel,
};

// Projects carrying measured figures lead as full-width rows; the rest fill a
// grid. Order comes from the content file — this only decides density.
const features = projects.items.filter((p) => p.featured || p.metrics);
const compact = projects.items.filter((p) => !p.featured && !p.metrics);
---

<section id="projects" class="band shell">
  <div class="band-head">
    <p class="eyebrow">{projects.heading}</p>
    <h2 class="h-section">{projects.subheading}</h2>
  </div>

  <div class="mt-12 space-y-6">
    {
      features.map((project, i) => (
        <ProjectCard project={project} labels={labels} feature flip={i % 2 === 1} index={i} />
      ))
    }
  </div>

  {
    compact.length > 0 && (
      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {compact.map((project, i) => (
          <ProjectCard project={project} labels={labels} index={features.length + i} />
        ))}
      </div>
    )
  }
</section>
