---
import { getContent } from "@/i18n";
import ExtractionPanel from "@/components/ExtractionPanel.astro";
import Portrait from "@/components/Portrait.astro";

const lang = Astro.currentLocale ?? "en";
const { hero, person } = getContent(lang);
---

{/* Asymmetric on purpose: the claim takes the wide column and the proof sits
    beside it, rather than the centred stack the old hero used. */}
<section id="top" class="shell relative grid items-center gap-14 pb-16 pt-28 sm:pt-36 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:pb-24 lg:pt-44">
  <div>
    <div class="flex animate-rise items-center gap-3">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-pulse-dot rounded-pill bg-gold"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-pill bg-gold"></span>
      </span>
      <p class="key">{hero.eyebrow}</p>
    </div>

    <h1 class="display mt-6 animate-rise text-hero" style="animation-delay:60ms">
      {hero.headline}
    </h1>

    <p class="lead mt-7 animate-rise" style="animation-delay:120ms">{hero.subhead}</p>

    <div class="mt-9 flex animate-rise flex-wrap items-center gap-3" style="animation-delay:180ms">
      <a href={hero.ctaPrimary.href} class="btn-gold">
        {hero.ctaPrimary.label}
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a href={person.links.upwork} target="_blank" rel="noopener noreferrer" class="btn-line">
        {hero.ctaSecondary.label}
      </a>
    </div>

    <div class="mt-10 flex animate-rise items-center gap-3 border-t border-edge pt-6" style="animation-delay:240ms">
      <Portrait class="h-10 w-10 shrink-0 rounded-pill" placeholderClass="text-sm" loading="eager" fetchpriority="high" />
      <p class="text-[13px] leading-snug text-fg-faint">
        <span class="text-fg-muted">{person.location}</span> · {person.locationNote}
      </p>
    </div>
  </div>

  <div class="animate-rise lg:pl-4" style="animation-delay:300ms">
    <ExtractionPanel />
  </div>
</section>
