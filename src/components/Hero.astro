---
import { hero, person } from "@/data/content";
import DocToJson from "@/components/DocToJson.astro";
import Portrait from "@/components/Portrait.astro";
---

<section id="top" class="section-shell relative flex flex-col gap-16 pb-24 pt-16 sm:pt-24 lg:flex-row lg:items-center lg:gap-12 lg:pb-32 lg:pt-28">
  <div class="max-w-xl animate-fade-up">
    <Portrait
      class="mx-auto mb-6 h-40 w-40 lg:mx-0 lg:h-[340px] lg:w-[340px]"
      placeholderClass="text-5xl lg:text-8xl"
      loading="eager"
      fetchpriority="high"
    />
    <p class="section-heading">{hero.eyebrow}</p>
    <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] tracking-tight text-ink-900 sm:text-5xl lg:text-[3.25rem] dark:text-ink-100">
      {hero.headline}
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-ink-400">
      {hero.subhead}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href={hero.ctaPrimary.href}
        class="inline-flex items-center gap-2 rounded-full bg-ink-900 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-ink-900/10 transition-all hover:-translate-y-0.5 hover:bg-accent-dim dark:bg-accent dark:text-ink-950 dark:shadow-accent/20 dark:hover:bg-accent-bright"
      >
        {hero.ctaPrimary.label}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a
        href={hero.ctaSecondary.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-ink-200 px-5 py-3 text-sm font-semibold text-ink-900 transition-colors hover:border-accent/50 hover:text-accent-dim dark:border-ink-700 dark:text-ink-100 dark:hover:text-accent"
      >
        {hero.ctaSecondary.label}
      </a>
    </div>

    <div class="mt-10 flex items-center gap-3 text-sm text-ink-400">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
      </span>
      {person.location} · {person.locationNote}
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-md animate-fade-up lg:mx-0 lg:max-w-lg" style="animation-delay: 150ms">
    <DocToJson />
  </div>
</section>
