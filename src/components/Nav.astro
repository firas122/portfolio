---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getContent, locales, localeLabels, type Locale } from "@/i18n";

const lang = (Astro.currentLocale as Locale) ?? "en";
const { nav, person, ui } = getContent(lang);

const langOptions = locales.map((locale) => ({
  code: locale,
  label: localeLabels[locale],
  href: getRelativeLocaleUrl(locale, "/"),
  current: locale === lang,
}));

const initials = person.name
  .split(" ")
  .map((part) => part[0])
  .join("");
---

{/* Floating rather than docked: the bar detaches from the page so the hero
    reads full-bleed behind it, and it gains its surface only once scrolled. */}
<header class="pointer-events-none fixed inset-x-0 top-0 z-50 pt-3 sm:pt-4">
  <div class="shell">
    <div
      id="navbar"
      class="pointer-events-auto flex items-center gap-3 rounded-pill border border-transparent px-3 py-2 transition-[background-color,border-color,box-shadow,padding] duration-300 ease-out sm:px-4"
    >
      <a href="#top" class="group flex shrink-0 items-center gap-2.5" aria-label={person.name}>
        <span
          class="grid h-8 w-8 place-items-center rounded-pill bg-gold-sweep font-mono text-[12px] font-medium text-gold-on"
        >
          {initials}
        </span>
        <span class="hidden font-display text-[15px] font-semibold tracking-tight sm:block">
          {person.name}
        </span>
      </a>

      <nav class="ml-auto hidden items-center gap-1 lg:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="rounded-pill px-3 py-1.5 text-[13.5px] font-medium text-fg-muted transition-colors duration-200 hover:bg-panel-high hover:text-fg"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="ml-auto flex items-center gap-1.5 lg:ml-2">
        <div class="hidden items-center rounded-pill border border-edge p-0.5 sm:flex">
          {
            langOptions.map((option) => (
              <a
                href={option.href}
                class:list={[
                  "rounded-pill px-2.5 py-1 font-mono text-[11px] uppercase transition-colors",
                  option.current ? "bg-fg text-bg" : "text-fg-faint hover:text-fg",
                ]}
                aria-current={option.current ? "true" : undefined}
              >
                {option.code}
              </a>
            ))
          }
        </div>

        <button
          id="theme-toggle"
          type="button"
          class="grid h-8 w-8 place-items-center rounded-pill border border-edge text-fg-muted transition-colors hover:border-gold hover:text-gold"
          aria-label={ui.themeToggle}
        >
          <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
          </svg>
        </button>

        <a href="#contact" class="btn-gold hidden h-8 px-4 py-0 text-[13px] sm:inline-flex">
          {ui.contactCta}
        </a>

        <button
          id="menu-toggle"
          type="button"
          class="grid h-8 w-8 place-items-center rounded-pill border border-edge text-fg-muted lg:hidden"
          aria-label={ui.menuToggle}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="glass pointer-events-auto mt-2 hidden rounded-panel p-2 lg:hidden">
      <nav class="grid">
        {
          nav.map((item) => (
            <a
              href={item.href}
              data-menu-link
              class="rounded-[10px] px-3 py-2.5 text-sm font-medium text-fg-muted transition-colors hover:bg-panel-high hover:text-fg"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="mt-2 flex items-center gap-2 border-t border-edge px-3 pt-3">
        {
          langOptions.map((option) => (
            <a
              href={option.href}
              class:list={[
                "rounded-pill px-2.5 py-1 font-mono text-[11px] uppercase",
                option.current ? "bg-fg text-bg" : "text-fg-faint",
              ]}
            >
              {option.label}
            </a>
          ))
        }
        <a href="#contact" data-menu-link class="btn-gold ml-auto h-8 px-4 py-0 text-[13px]">{ui.contactCta}</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    // The bar is transparent over the hero and gains its glass surface once the
    // page moves, so the landing view is not cut by a horizontal band.
    const bar = document.getElementById("navbar");
    const onScroll = () => {
      const scrolled = window.scrollY > 12;
      bar.classList.toggle("glass", scrolled);
      bar.classList.toggle("shadow-lg", scrolled);
      bar.classList.toggle("shadow-black/5", scrolled);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const toggle = document.getElementById("theme-toggle");
    toggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });

    const menuBtn = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const setMenu = (open) => {
      menu.classList.toggle("hidden", !open);
      menuBtn.setAttribute("aria-expanded", String(open));
    };
    menuBtn?.addEventListener("click", () => setMenu(menu.classList.contains("hidden")));
    menu?.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => setMenu(false)));
    document.addEventListener("keydown", (event) => event.key === "Escape" && setMenu(false));
  })();
</script>
