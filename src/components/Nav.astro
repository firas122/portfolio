---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getContent, locales, localeLabels, type Locale } from "@/i18n";

const lang = (Astro.currentLocale as Locale) ?? "en";
const { nav, person, ui } = getContent(lang);
const langOptions = locales.map((locale) => ({
  code: locale,
  label: localeLabels[locale],
  href: getRelativeLocaleUrl(locale, "/"),
  current: locale === lang,
}));
---

<header class="sticky top-0 z-50 w-full border-b border-ink-200/70 bg-white/75 backdrop-blur-md dark:border-ink-700/60 dark:bg-ink-950/70">
  <div class="section-shell flex h-16 items-center justify-between">
    <a href="#top" class="group flex items-center gap-2 font-mono text-sm font-semibold text-ink-900 dark:text-ink-100">
      <span class="flex h-7 w-7 items-center justify-center rounded-md border border-accent/40 bg-accent/10 text-accent-dim transition-colors group-hover:bg-accent/20 dark:text-accent">
        FJ
      </span>
      <span class="hidden sm:inline">{person.name}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-ink-400 transition-colors hover:text-ink-900 dark:hover:text-ink-100"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="relative">
        <button
          id="lang-menu-toggle"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-menu"
          class="flex h-9 items-center gap-1.5 rounded-full border border-ink-200 pl-3 pr-2.5 font-mono text-xs font-semibold text-ink-400 transition-colors hover:border-accent/50 hover:text-accent-dim dark:border-ink-700 dark:hover:text-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3a13.5 13.5 0 0 1 0 18M12 3a13.5 13.5 0 0 0 0 18"></path>
          </svg>
          {lang.toUpperCase()}
          <svg id="lang-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3 transition-transform">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <div
          id="lang-menu"
          role="menu"
          class="invisible absolute right-0 top-full z-50 mt-2 w-36 origin-top-right scale-95 rounded-xl border border-ink-200/70 bg-white p-1 opacity-0 shadow-lg shadow-ink-900/[0.08] transition duration-150 ease-out dark:border-ink-700/60 dark:bg-ink-900"
        >
          {
            langOptions.map((option) => (
              <a
                href={option.href}
                hreflang={option.code}
                role="menuitem"
                aria-current={option.current ? "true" : undefined}
                class={`flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm transition-colors ${
                  option.current
                    ? "font-semibold text-accent-dim dark:text-accent"
                    : "text-ink-400 hover:bg-ink-100/70 hover:text-ink-900 dark:hover:bg-ink-800 dark:hover:text-ink-100"
                }`}
              >
                {option.label}
                {option.current && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <button
        id="theme-toggle"
        type="button"
        aria-label={ui.themeToggle}
        class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-400 transition-colors hover:border-accent/50 hover:text-accent-dim dark:border-ink-700 dark:hover:text-accent"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-4 w-4">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-4 w-4">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
      </button>

      <a
        href="#contact"
        class="hidden rounded-full bg-ink-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-dim md:inline-flex dark:bg-accent dark:text-ink-950 dark:hover:bg-accent-bright"
      >
        {ui.contactCta}
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label={ui.menuToggle}
        aria-expanded="false"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-400 md:hidden dark:border-ink-700"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-ink-200/70 px-6 pb-4 md:hidden dark:border-ink-700/60">
    <ul class="flex flex-col gap-1 pt-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-lg px-2 py-2 text-sm font-medium text-ink-400 hover:bg-ink-100/50 hover:text-ink-900 dark:hover:bg-ink-800 dark:hover:text-ink-100"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");
  const sunIcon = document.getElementById("icon-sun");
  const moonIcon = document.getElementById("icon-moon");

  function syncIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    sunIcon?.classList.toggle("hidden", !isDark);
    moonIcon?.classList.toggle("hidden", isDark);
  }

  syncIcons();

  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    syncIcons();
  });

  const menuToggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    menuToggle.setAttribute("aria-expanded", String(isOpen));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      menuToggle?.setAttribute("aria-expanded", "false");
    });
  });

  const langToggle = document.getElementById("lang-menu-toggle");
  const langMenu = document.getElementById("lang-menu");
  const langChevron = document.getElementById("lang-chevron");
  const langMenuOpenClasses = ["visible", "scale-100", "opacity-100"];
  const langMenuClosedClasses = ["invisible", "scale-95", "opacity-0"];

  function setLangMenuOpen(isOpen: boolean) {
    langMenuOpenClasses.forEach((cls) => langMenu?.classList.toggle(cls, isOpen));
    langMenuClosedClasses.forEach((cls) => langMenu?.classList.toggle(cls, !isOpen));
    langChevron?.classList.toggle("rotate-180", isOpen);
    langToggle?.setAttribute("aria-expanded", String(isOpen));
  }

  langToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    const isOpen = langToggle.getAttribute("aria-expanded") === "true";
    setLangMenuOpen(!isOpen);
  });

  document.addEventListener("click", (event) => {
    if (langToggle?.getAttribute("aria-expanded") !== "true") return;
    if (langMenu?.contains(event.target as Node) || langToggle.contains(event.target as Node)) return;
    setLangMenuOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setLangMenuOpen(false);
  });
</script>
