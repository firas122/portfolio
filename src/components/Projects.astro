---
import { getContent } from "@/i18n";

const lang = Astro.currentLocale ?? "en";
const { projects } = getContent(lang);
---

<section id="projects" class="section-shell py-14 sm:py-20">
  <p class="section-heading">{projects.heading}</p>
  <h2 class="mt-3 max-w-xl text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-ink-100">
    {projects.subheading}
  </h2>

  <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
    {
      projects.items.map((project) => (
        <article class="panel glow-border flex flex-col rounded-2xl p-6">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/10 px-2.5 py-1 font-mono text-[10px] uppercase tracking-widest text-accent-dim dark:text-accent">
              {project.tag}
            </span>
          </div>

          <h3 class="mt-4 text-xl font-semibold text-ink-900 dark:text-ink-100">{project.title}</h3>

          <div class="mt-4 space-y-3 text-sm leading-relaxed text-ink-400">
            <p>
              <span class="font-semibold text-ink-900 dark:text-ink-100">{projects.problemLabel} </span>
              {project.problem}
            </p>
            <p>
              <span class="font-semibold text-ink-900 dark:text-ink-100">{projects.approachLabel} </span>
              {project.approach}
            </p>
            <p>
              <span class="font-semibold text-ink-900 dark:text-ink-100">{projects.outcomeLabel} </span>
              {project.outcome}
            </p>
          </div>

          <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
            {project.stack.map((tech) => (
              <span class="rounded-md bg-ink-100/80 px-2 py-1 font-mono text-[11px] text-ink-400 dark:bg-ink-800 dark:text-ink-200">
                {tech}
              </span>
            ))}
          </div>

          {project.link && (
            <a
              href={project.link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-dim hover:text-accent-bright dark:text-accent"
            >
              {project.link.label}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
