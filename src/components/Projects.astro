---
import { getContent } from "@/i18n";
import ProjectLinks from "@/components/ProjectLinks.astro";

const lang = Astro.currentLocale ?? "en";
const { projects } = getContent(lang);

// The headline project gets the full width and its figures up top; everything
// else runs two-up. Order is taken from the content file, not re-sorted here.
// Card metrics use a fixed three-up grid rather than wrapping flex: wrapping
// left the third figure stranded alone on its own row.
const featured = projects.items.filter((p) => p.featured);
const rest = projects.items.filter((p) => !p.featured);
---

<section id="projects" class="section-shell scroll-mt-24 py-16 sm:py-24">
  <p class="field-label">{projects.heading}</p>
  <h2 class="section-title max-w-2xl">{projects.subheading}</h2>

  {
    featured.map((project) => (
      <article class="record record-hover mt-12 overflow-hidden">
        <div class="flex flex-wrap items-center gap-3 border-b border-ink-200 px-6 py-4 dark:border-ink-700">
          <span class="badge-accent">{project.tag}</span>
          <h3 class="font-display text-[1.65rem] leading-tight text-ink-900 dark:text-ink-100">
            {project.title}
          </h3>
        </div>

        {project.metrics && (
          <dl class="grid grid-cols-1 divide-y divide-ink-200 border-b border-ink-200 sm:grid-cols-3 sm:divide-x sm:divide-y-0 dark:divide-ink-700 dark:border-ink-700">
            {project.metrics.map((metric) => (
              <div class="px-6 py-5">
                <dd class="metric-value">{metric.value}</dd>
                <dt class="metric-key">{metric.label}</dt>
              </div>
            ))}
          </dl>
        )}

        <div class="grid gap-x-10 gap-y-6 px-6 py-7 md:grid-cols-2">
          <div class="space-y-5 text-[15px] leading-relaxed text-ink-600 dark:text-ink-200">
            <p>
              <span class="field-label mb-1 block">{projects.problemLabel}</span>
              {project.problem}
            </p>
            <p>
              <span class="field-label mb-1 block">{projects.outcomeLabel}</span>
              {project.outcome}
            </p>
          </div>
          <p class="text-[15px] leading-relaxed text-ink-600 dark:text-ink-200">
            <span class="field-label mb-1 block">{projects.approachLabel}</span>
            {project.approach}
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-ink-200 px-6 py-4 dark:border-ink-700">
          <div class="flex flex-wrap gap-1.5">
            {project.stack.map((tech) => (
              <span class="badge">{tech}</span>
            ))}
          </div>
          <ProjectLinks links={project.links} note={project.linkNote} />
        </div>
      </article>
    ))
  }

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
    {
      rest.map((project) => (
        <article class="record record-hover flex flex-col overflow-hidden">
          <div class="flex items-center gap-3 border-b border-ink-200 px-5 py-3.5 dark:border-ink-700">
            <span class="badge-accent">{project.tag}</span>
          </div>

          <div class="flex flex-1 flex-col px-5 py-5">
            <h3 class="font-display text-[1.35rem] leading-tight text-ink-900 dark:text-ink-100">
              {project.title}
            </h3>

            {project.metrics && (
              <dl class="mt-4 grid grid-cols-3 gap-x-4 border-y border-ink-200 py-3.5 dark:border-ink-700">
                {project.metrics.map((metric) => (
                  <div class="min-w-0">
                    <dd class="metric-value text-[1.15rem]">{metric.value}</dd>
                    <dt class="metric-key">{metric.label}</dt>
                  </div>
                ))}
              </dl>
            )}

            <div class="mt-5 space-y-4 text-[14.5px] leading-relaxed text-ink-600 dark:text-ink-200">
              <p>
                <span class="field-label mb-1 block">{projects.problemLabel}</span>
                {project.problem}
              </p>
              <p>
                <span class="field-label mb-1 block">{projects.approachLabel}</span>
                {project.approach}
              </p>
              <p>
                <span class="field-label mb-1 block">{projects.outcomeLabel}</span>
                {project.outcome}
              </p>
            </div>

            <div class="mt-auto flex flex-wrap gap-1.5 pt-6">
              {project.stack.map((tech) => (
                <span class="badge">{tech}</span>
              ))}
            </div>
          </div>

          {(project.links || project.linkNote || project.link) && (
            <div class="border-t border-ink-200 px-5 py-4 dark:border-ink-700">
              <ProjectLinks links={project.links} note={project.linkNote} legacy={project.link} />
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>
